# PSG NEXUS Configuration Template (Never commit real secrets)

# Express Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
REQUEST_TIMEOUT_MS=10000
EMBEDDING_TIMEOUT_MS=7000
GEMINI_MAX_CONCURRENCY=5

# MongoDB Atlas / Local Fallback
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/psg_chatbot
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/psg_chatbot
MONGODB_DB_NAME=psg_chatbot
MONGODB_COLLECTION=website_chunks
VECTOR_INDEX_NAME=vector_index
DOCUMENTS_COLLECTION=knowledge_documents
CHUNKS_COLLECTION=knowledge_chunks
STAGING_CHUNKS_COLLECTION=knowledge_chunks_staging
KNOWLEDGE_VECTOR_INDEX_NAME=knowledge_vector_index

# Security & Rate Limiting
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SESSION_SECRET=replace_with_a_long_random_hex_secret_in_production
ADMIN_API_KEY=replace_with_strong_admin_api_key
REVIEWER_API_KEY=replace_with_strong_reviewer_api_key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
ADMIN_RATE_LIMIT_MAX=60
MAX_BODY_SIZE=100kb
ALLOWED_FETCH_HOSTS=www.psgtech.edu,psgtech.edu,sports.psgtech.ac.in,library.psgtech.ac.in,thebridge.psgtech.ac.in,academicschedule.psgtech.ac.in,iipc.psgtech.ac.in,platinum.psgtech.ac.in

# RAG Retrieval Settings
RAG_CANDIDATE_LIMIT=15
RAG_EVIDENCE_LIMIT=5
RAG_MIN_VECTOR_SCORE=0.45
RAG_CACHE_TTL_MS=300000
MAX_CONVERSATION_TURNS=8
