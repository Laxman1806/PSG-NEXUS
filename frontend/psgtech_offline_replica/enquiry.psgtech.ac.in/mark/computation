
var _COMPUTE = {
    DEFAULT: function (subjects) {
        var MATHEMATICS = subjects.find(function (subject) { return subject.name == "MATHEMATICS" })
        var PHYSICS = subjects.find(function (subject) { return subject.name == "PHYSICS" })
        var CHEMISTRY = subjects.find(function (subject) { return subject.name == "CHEMISTRY" })
        var cutOff = 0;

        if (MATHEMATICS && MATHEMATICS.plus2 && MATHEMATICS.plus2.secured)
            cutOff += MATHEMATICS.plus2.secured;

        if (PHYSICS && PHYSICS.plus2 && PHYSICS.plus2.secured)
            cutOff += (PHYSICS.plus2.secured / 2);

        if (CHEMISTRY && CHEMISTRY.plus2 && CHEMISTRY.plus2.secured)
            cutOff += (CHEMISTRY.plus2.secured / 2);

        return parseFloat(cutOff.toFixed(2));
    },
    TSANDAP: function (subjects) {
        var MATHEMATICS = subjects.find(function (subject) { return subject.name == "MATHEMATICS" })
        var PHYSICS = subjects.find(function (subject) { return subject.name == "PHYSICS" })
        var CHEMISTRY = subjects.find(function (subject) { return subject.name == "CHEMISTRY" })
        var cutOff = 0;

        if (MATHEMATICS && MATHEMATICS.plus2 && MATHEMATICS.plus2.secured && MATHEMATICS.plus1 && MATHEMATICS.plus1.secured)
            cutOff += ((MATHEMATICS.plus2.secured + MATHEMATICS.plus1.secured) / 3);

        if (PHYSICS && PHYSICS.plus2 && PHYSICS.plus2.secured && PHYSICS.plus1 && PHYSICS.plus1.secured)
            cutOff += ((PHYSICS.plus2.secured + PHYSICS.plus1.secured) / 3);

        if (CHEMISTRY && CHEMISTRY.plus2 && CHEMISTRY.plus2.secured && CHEMISTRY.plus1 && CHEMISTRY.plus1.secured)
            cutOff += ((CHEMISTRY.plus2.secured + CHEMISTRY.plus1.secured) / 3);

        return parseFloat(cutOff.toFixed(2));
    },
    KL: function (subjects) {
        var MATHEMATICS = subjects.find(function (subject) { return subject.name == "MATHEMATICS" })
        var PHYSICS = subjects.find(function (subject) { return subject.name == "PHYSICS" })
        var CHEMISTRY = subjects.find(function (subject) { return subject.name == "CHEMISTRY" })
        var cutOff = 0;

        if (MATHEMATICS && MATHEMATICS.plus2 && MATHEMATICS.plus2.secured && MATHEMATICS.plus1 && MATHEMATICS.plus1.secured)
            cutOff += ((MATHEMATICS.plus2.secured + MATHEMATICS.plus1.secured) / 2);

        if (PHYSICS && PHYSICS.plus2 && PHYSICS.plus2.secured && PHYSICS.plus1 && PHYSICS.plus1.secured)
            cutOff += ((PHYSICS.plus2.secured + PHYSICS.plus1.secured) / 4);

        if (CHEMISTRY && CHEMISTRY.plus2 && CHEMISTRY.plus2.secured && CHEMISTRY.plus1 && CHEMISTRY.plus1.secured)
            cutOff += ((CHEMISTRY.plus2.secured + CHEMISTRY.plus1.secured) / 4);

        return parseFloat(cutOff.toFixed(2));
    }
}

var _CUTOFFMAP = {
    "TNHSC": _COMPUTE.DEFAULT,
    "CBSE": _COMPUTE.DEFAULT,
    "ISC": _COMPUTE.DEFAULT,
    "NIOS": _COMPUTE.DEFAULT,
    "IB": _COMPUTE.DEFAULT,
    "IGCSE": _COMPUTE.DEFAULT,
    "KARNATAKA HSC": _COMPUTE.DEFAULT,
    "TELANGANA HSC": _COMPUTE.TSANDAP,
    "ANDHRA HSC": _COMPUTE.TSANDAP,
    "KERALA HSC": _COMPUTE.KL,
    "OTHERS": _COMPUTE.DEFAULT,
}

function _TOTAL_PERCENTAGE(subjects) {
    var total = {
        secured: 0,
        outOf: 0
    }, percentage = 0;

    subjects = subjects.filter(sub => sub.name != 'NA');

    subjects.forEach(function (subject) {
        subject.total.outOf = 0;
        subject.total.secured = 0;
        if (subject.plus1.outOf) {
            subject.total.outOf += subject.plus1.outOf;
        }
        if (subject.plus2.outOf) {
            subject.total.outOf += subject.plus2.outOf;
        }
        if (subject.plus1.secured) {
            subject.total.secured += subject.plus1.secured;
        }
        if (subject.plus2.secured) {
            subject.total.secured += subject.plus2.secured;
        }
        total.outOf += subject.total.outOf
        total.secured += subject.total.secured
    })
    if (total.secured && total.outOf)
        percentage = parseFloat(((total.secured / total.outOf) * 100).toFixed(2));

    return {
        total: total,
        percentage: percentage
    }
}

if (typeof module === "object" && module && typeof module.exports === "object") {
    module.exports = {
        _COMPUTE,
        _CUTOFFMAP,
        _TOTAL_PERCENTAGE
    };
} else {
    window._COMPUTE = _COMPUTE;
    window._CUTOFFMAP = _CUTOFFMAP;
    window._TOTAL_PERCENTAGE = _TOTAL_PERCENTAGE;
    if (typeof define === "function" && define.amd) {
        define("_COMPUTE", [], function () { return _COMPUTE; });
        define("_CUTOFFMAP", [], function () { return _CUTOFFMAP; });
        define("_TOTAL_PERCENTAGE", [], function () { return _TOTAL_PERCENTAGE; });
    }
}
