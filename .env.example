# Server Configuration
PORT=5000

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Connection URI (Atlas or local fallback: mongodb://127.0.0.1:27017/psg_chatbot)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/psg_chatbot
MONGODB_COLLECTION=website_chunks
VECTOR_INDEX_NAME=vector_index

# Optional Security Tuning
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# CHAT_RATE_LIMIT_MAX=60
